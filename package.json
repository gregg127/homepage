{
  "name": "golebiowski_homepage",
  "version": "1.43",
  "private": true,
  "description": "Grzegorz Gołębiowski - personal website",
  "author": "Grzegorz Gołębiowski",
  "keywords": [
    "gatsby"
  ],
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "dev": "gatsby develop",
    "dev:cv": "cd cv && latexmk -c && latexmk -pdf -pvc Grzegorz-Golebiowski-Java-Tech-Lead-CV.tex",
    "build:cv": "command -v latexmk >/dev/null 2>&1 && (cd cv && latexmk -c && latexmk -pdf Grzegorz-Golebiowski-Java-Tech-Lead-CV.tex && cp Grzegorz-Golebiowski-Java-Tech-Lead-CV.pdf ../static/) || echo 'Warning: latexmk not found, skipping CV PDF build'",
    "build": "npm run build:cv && gatsby build",
    "clean": "gatsby clean",
    "containerUp": "docker compose up -d --build",
    "containerDown": "docker compose down",
    "docs": "docsify serve docsify --open",
    "test": "node --test tests/*.test.js",
    "deploy": "./deploy.sh"
  },
  "dependencies": {
    "@fontsource/courier-prime": "^5.2.8",
    "@fontsource/lato": "^5.2.7",
    "babel-plugin-styled-components": "^2.1.4",
    "chrome-launcher": "^1.2.1",
    "gatsby": "^5.16.1",
    "gatsby-plugin-manifest": "^5.16.0",
    "gatsby-plugin-robots-txt": "^1.8.0",
    "gatsby-plugin-sitemap": "^6.16.0",
    "gatsby-plugin-styled-components": "^6.16.0",
    "gatsby-remark-autolink-headers": "^6.16.0",
    "gatsby-source-filesystem": "^5.16.0",
    "gatsby-transformer-remark": "^6.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "string-replace-loader": "^3.3.0",
    "styled-components": "^6.4.1"
  },
  "devDependencies": {
    "axe-core": "^4.11.4",
    "cheerio": "^1.2.0",
    "docsify-cli": "^4.4.4",
    "jsdom": "^29.1.1"
  }
}
